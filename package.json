{
  "name": "unreal-mcp-ue4-for-ohd",
  "version": "2026.5.12-11",
  "mcpName": "io.github.ribattrw/unreal-mcp-ue4-for-ohd",
  "description": "UE4.25-first MCP server for controlling the Unreal Editor through Unreal Python Remote Execution (Operation Harsh Doorstop mod-kit retarget).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "unreal-mcp-ue4-for-ohd": "dist/bin.js"
  },
  "scripts": {
    "dev": "tsx --watch server/bin.ts",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "start": "node dist/bin.js",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:no-unreal": "npm run build && node scripts/no-unreal-smoke.mjs && node scripts/check-payload-codec.mjs && node scripts/check-batch-prototype.mjs && node scripts/check-prelude-cache.mjs && node scripts/check-tool-surface.mjs && node scripts/check-dispatch-envelope.mjs && node scripts/check-bounded-reads.mjs && node scripts/check-schema-parity.mjs && node scripts/check-connection-session.mjs && node scripts/check-connection-session-effect.mjs",
    "typecheck": "tsc --noEmit",
    "check:py27": "node scripts/check-py27.mjs",
    "check:compat-direction": "node scripts/check-compat-direction.mjs",
    "check:codec": "node scripts/check-payload-codec.mjs",
    "check:session": "node scripts/check-connection-session.mjs",
    "check:session-effect": "node scripts/check-connection-session-effect.mjs",
    "postbuild": "node dist/scripts/make-executable.js && node dist/scripts/update-readme.js",
    "publish:check": "npm run typecheck && npm run build && npm pack --dry-run",
    "fmt": "biome format . --write && biome check --formatter-enabled=false --linter-enabled=false --organize-imports-enabled=true --write",
    "set:version": "node scripts/set-version.mjs",
    "sync:version": "node scripts/sync-version.mjs"
  },
  "files": ["dist"],
  "keywords": ["unreal", "mcp", "modelcontextprotocol", "unreal-mcp", "ue4", "ue4.25", "ohd"],
  "author": "RibatTRW",
  "license": "MIT",
  "packageManager": "npm@10.8.1",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RibatTRW/unreal-mcp-ue4-for-OHD.git"
  },
  "homepage": "https://github.com/RibatTRW/unreal-mcp-ue4-for-OHD#readme",
  "bugs": {
    "url": "https://github.com/RibatTRW/unreal-mcp-ue4-for-OHD/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "effect": "^3.22.1",
    "unreal-remote-execution": "^1.0.0",
    "zod": "^3.25.48"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.29",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
